# ===========================================
# ohrmin-claw - 환경변수 설정
# 이 파일을 .env로 복사한 후 값을 채워주세요
# cp .env.example .env
# ===========================================

# --- Garmin Connect ---
# Garmin Connect 계정 (garminconnect.com)
GARMIN_USERNAME=your-email@example.com
GARMIN_PASSWORD=your-garmin-password

# --- Discord Bot ---
# Discord Developer Portal (discord.com/developers) 에서 발급
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_APPLICATION_ID=your-application-id
# 선택: 개발 서버 Guild ID (슬래시 커맨드 빠른 등록용)
# DISCORD_GUILD_ID=your-guild-id
# 허용할 Discord 유저 ID (쉼표 구분, 필수 설정)
# 비워두면 모든 메시지를 무시합니다 (화이트리스트 방식)
# Discord에서 유저 ID 확인: 설정 → 고급 → 개발자 모드 ON → 유저 우클릭 → "Copy User ID"
ALLOWED_USERS=123456789012345678

# --- LLM 어댑터 ---
# 사용할 LLM 어댑터 선택 (claude / codex)
LLM_ADAPTER=claude
# 사용할 모델 (미설정 시 기본값: claude-sonnet-4-20250514)
# LLM_MODEL=claude-sonnet-4-20250514

# Claude Agent SDK: `claude login` 완료 상태면 별도 키 불필요 (구독 모델)
# Codex SDK: `codex` 실행 → "Sign in with ChatGPT" 선택하면 별도 키 불필요 (구독 모델)
#   - 인증 정보 저장: ~/.codex/auth.json
#
# API 키 방식 (종량제) 사용 시:
# ANTHROPIC_API_KEY=sk-ant-...   (Claude API)
# OPENAI_API_KEY=sk-...          (Codex API)

# --- 메모리 & 세션 ---
# 메모리 모드: auto (대화 후 자동 추출) | manual (사용자가 명시적으로 요청)
MEMORY_MODE=auto
# 세션 idle 타임아웃 (분). 기본 1440 (24시간). 초과 시 스레드 히스토리 미로드.
SESSION_IDLE_TIMEOUT=1440

# --- Apple Health 자동 동기화 ---
# Health Auto Export 앱 (iOS) → iCloud Drive → 봇이 2분마다 자동 폴링
# 새 체성분 데이터 감지 시 NOTIFY_CHANNEL_ID 채널에 스레드 생성 + Claude 분석 전송
#
# 자동 분석 결과를 보낼 Discord 채널 ID (미설정 시 자동 분석 비활성화)
NOTIFY_CHANNEL_ID=
# iCloud Drive 내 Health Auto Export 폴더 경로 (기본값 사용 시 생략 가능)
# APPLE_HEALTH_EXPORT_DIR=~/Library/Mobile Documents/iCloud~com~ifunography~HealthExport/Documents/daily inbody
#
# 설정 방법:
#   1. iPhone: Health Auto Export 앱 설치 (Premium $6.99/년)
#   2. Automations → iCloud Drive, 주기: 원하는 빈도(예: 매 15분/매 1시간), 포맷: JSON
#      (봇은 2분마다 iCloud를 폴링하므로, iOS 앱 export 주기가 실제 갱신 빈도를 결정)
#   3. Mac Finder: Health Auto Export 폴더 우클릭 → "항상 이 Mac에 유지"
